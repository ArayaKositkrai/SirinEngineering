@model SirinEngineering.Models.db.UserModel
@{
    Layout = "~/Views/Shared/Layout/_CustomerLayout.cshtml";
    var checkoutItems = ViewBag.CheckoutItems as List<SirinEngineering.ViewModels.CartItemViewModel>;
    
    // ดักจับป้องกันหน้าพัง ถ้าหาตะกร้าไม่เจอให้ค่าเป็น 0
    decimal subTotal = checkoutItems?.Sum(x => x.Price * x.Quantity) ?? 0;
    decimal shippingFee = subTotal >= 2000 ? 0 : 150;
    decimal grandTotal = subTotal + shippingFee; 
}

<style>
    :root { --sirin-blue: #003D7C; }
    body { background-color: #f8fafc; }
    .checkout-wrapper { max-width: 1100px; margin: 40px auto; font-family: 'Prompt', sans-serif; }
    .card-box { background: #fff; border-radius: 16px; padding: 30px; border: 1px solid #e2e8f0; box-shadow: 0 4px 20px rgba(0,0,0,0.03); }
    .qr-wrapper { background: #f8fafc; border-radius: 16px; padding: 25px; text-align: center; border: 2px dashed #cbd5e1; height: 100%; }
    .qr-img { width: 200px; height: 200px; background: #fff; padding: 10px; border-radius: 12px; border: 1px solid #e2e8f0; }
    
    .btn-confirm { background: var(--sirin-blue); color: white; border: none; padding: 20px; border-radius: 12px; font-weight: bold; font-size: 1.4rem; transition: 0.3s; width: 100%; box-shadow: 0 10px 20px rgba(0,61,124,0.15); }
    .btn-confirm:hover { background: #002d5c; transform: translateY(-3px); }
</style>

<div class="checkout-wrapper pb-5">
    <h2 class="fw-bold mb-4" style="color: var(--sirin-blue); text-align: center;">ชำระเงินและระบุที่อยู่จัดส่ง</h2>

    @if (checkoutItems == null || !checkoutItems.Any())
    {
        <div class="alert alert-danger text-center fw-bold rounded-4 p-5 shadow-sm border-0">
            <i class="bi bi-exclamation-octagon-fill fs-1 d-block mb-3 text-danger"></i>
            ไม่พบรายการสินค้า หรือหมดเวลาทำรายการ กรุณากลับไปเริ่มใหม่ที่ตะกร้าสินค้าครับ
            <br><br>
            <a asp-action="Cart" class="btn btn-outline-danger px-4 rounded-pill fw-bold">กลับไปหน้าตะกร้าสินค้า</a>
        </div>
    }
    else
    {
        <form asp-controller="Product" asp-action="ConfirmOrder" method="post">
            <div class="row g-4 mb-4">
                
                <div class="col-lg-7">
                    <div class="card-box h-100">
                        <h4 class="fw-bold border-bottom pb-3 mb-4">ที่อยู่สำหรับจัดส่ง</h4>
                        <div class="row mb-3">
                            <div class="col-6">
                                <label class="fw-bold text-muted small mb-1">ชื่อ-นามสกุล</label>
                                <input type="text" class="form-control bg-light border-0 p-3" value="@Model.U_FullName" readonly style="border-radius:10px;">
                            </div>
                            <div class="col-6">
                                <label class="fw-bold text-muted small mb-1">เบอร์โทรศัพท์</label>
                                <input type="text" class="form-control bg-light border-0 p-3" value="@Model.U_Phone" readonly style="border-radius:10px;">
                            </div>
                        </div>
                        <div class="mb-0">
                            <label class="fw-bold text-dark mb-1">กรอกที่อยู่จัดส่ง <span class="text-danger">*</span></label>
                            <textarea name="U_Address" class="form-control p-3" rows="5" required style="border-radius:12px; border: 1px solid #cbd5e1;">@Model.U_Address</textarea>
                            <small class="text-primary fw-bold mt-2 d-block">* ระบบจะจำที่อยู่นี้ไว้ใช้ในครั้งถัดไป</small>
                        </div>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="card-box h-100">
                        <h4 class="fw-bold border-bottom pb-3 mb-4">ยอดโอนสุทธิ: <span class="text-primary float-end">฿@grandTotal.ToString("N0")</span></h4>
                        <div class="qr-wrapper d-flex flex-column align-items-center justify-content-center">
                            <p class="fw-bold text-muted mb-3">สแกน QR เพื่อโอนเงินผ่านพร้อมเพย์</p>
                            <img src="https://upload.wikimedia.org/wikipedia/commons/d/d0/QR_code_for_mobile_English_Wikipedia.svg" class="qr-img mb-3" alt="QR Code">
                            <div class="badge bg-white text-dark border p-2 px-3 fs-6" style="border-radius: 50px;">
                                <span class="text-muted">เลขบัญชี:</span> 012-345-6789
                            </div>
                            <p class="mt-2 mb-0 fw-bold small text-muted">บริษัท ศิรินทร์ เอ็นจิเนียริ่ง จำกัด</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <button type="submit" class="btn-confirm">
                        ยืนยันการโอนเงินและสั่งซื้อสินค้า <i class="bi bi-check-circle-fill ms-2"></i>
                    </button>
                    <p class="text-center mt-3 text-muted fw-bold small">** เมื่อกดปุ่มแล้ว ระบบจะนำคุณไปยังหน้า "ประวัติการสั่งซื้อ" (MyOrders) ทันที</p>
                </div>
            </div>
        </form>
    }
</div>