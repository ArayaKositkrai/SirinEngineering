<div class="modal fade" id="promoCategory" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius:25px;">
            <form asp-action="CreatePromotion" method="post">
                <input type="hidden" name="PM_PromoType" value="CategorySale" />
                <div class="modal-body p-4">
                    <h5 class="fw-bold mb-4">ลดราคาเฉพาะหมวดหมู่</h5>
                    <div class="mb-3">
                        <label class="small fw-bold text-muted">ชื่อโปรโมชั่น</label>
                        <input name="PM_PromotionName" class="form-control border-0 bg-light p-3" required style="border-radius:12px;" />
                    </div>
                    <div class="mb-3">
                        <label class="small fw-bold text-muted">เลือกหมวดหมู่</label>
                        <select name="PM_TargetCategoryID" class="form-select border-0 bg-light p-3" style="border-radius:12px;">
                            @if(categories != null){
                                foreach (var cat in categories) { <option value="@cat.C_CategoryID">@cat.C_CategoryName</option> }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="small fw-bold text-muted">จำนวนเงินที่ลด (฿)</label>
                        <input name="PM_DiscountValue" type="number" min="1" class="form-control border-0 bg-light p-3" required style="border-radius:12px;" />
                    </div>

                    <div class="row mb-3">
                        <div class="col-6">
                            <label class="small fw-bold text-muted">วันที่เริ่ม</label>
                            <input name="PM_StartDate" type="date" class="form-control border-0 bg-light p-3" value="@DateTime.Now.ToString("yyyy-MM-dd")" style="border-radius:12px;" />
                        </div>
                        <div class="col-6">
                            <label class="small fw-bold text-muted">วันที่สิ้นสุด</label>
                            <input name="PM_EndDate" type="date" class="form-control border-0 bg-light p-3" required style="border-radius:12px;" />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-sirin w-100 p-3 fw-bold shadow-sm">บันทึกโปรโมชั่น</button>
                </div>
            </form>
        </div>
    </div>
</div>