@{
    Layout = "~/Views/Shared/Layout/_AdminLayout.cshtml";
    ViewData["Title"] = "Dashboard - Sirin Engineering";
}

<div style="padding: 20px;">
    <h2 class="fw-bold mb-0" style="color: #003D7C;">Dashboard</h2>
    <p style="color: #7F7F7F;">
    ยินดีต้อนรับ @User.Identity.Name เข้าสู่ระบบจัดการ Sirin Engineering
</p>
    
    <hr style="border: 1px solid #ddd;" />

    <div style="display: flex; gap: 20px; margin-top: 20px;">
        @* Card แสดงผลแบบ No-Script *@
        <div style="flex: 1; background: #fff; border-left: 5px solid #003D7C; padding: 20px; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
            <h4 style="margin: 0; color: #7F7F7F;">ยอดขายรวมวันนี้</h4>
            <h2 style="margin: 10px 0; color: #003D7C;">0.00 ฿</h2>
        </div>

        <div style="flex: 1; background: #fff; border-left: 5px solid #7F7F7F; padding: 20px; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
            <h4 style="margin: 0; color: #7F7F7F;">จำนวนออเดอร์</h4>
            <h2 style="margin: 10px 0; color: #333;">0 รายการ</h2>
        </div>
    </div>
</div>