<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin - Sirin Engineering</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        :root { --admin-blue: #003D7C; --admin-grey: #4A4A4A; }
        body { margin: 0; font-family: sans-serif; display: flex; }
        /* Sidebar  */
        .sidebar { width: 250px; height: 100vh; background: var(--admin-blue); color: white; position: fixed; }
        .sidebar-header { padding: 20px; text-align: center; border-bottom: 1px solid rgba(255,255,255,0.1); }
        .sidebar-header img { width: 80px; }
        .nav-menu { list-style: none; padding: 0; margin-top: 20px; }
        .nav-item a { display: block; padding: 15px 25px; color: white; text-decoration: none; transition: 0.3s; }
        .nav-item a:hover { background: rgba(255,255,255,0.1); border-left: 5px solid #fff; }
        .main-content { margin-left: 250px; flex: 1; background: #f4f4f4; min-height: 100vh; }
        .top-bar { background: white; padding: 15px 30px; display: flex; justify-content: space-between; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
        .btn-logout { color: var(--admin-blue); text-decoration: none; font-weight: bold; border: 1px solid var(--admin-blue); padding: 5px 15px; border-radius: 5px; }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="sidebar-header">
            <img src="~/images/Logo.jpg" alt="Logo" />
            <h3>Admin Panel</h3>
        </div>
        <ul class="nav-menu">
            <li class="nav-item"><a asp-controller="Admin" asp-action="Dashboard">📊 Dashboard</a></li>
            <li class="nav-item"><a asp-controller="Admin" asp-action="StaffManage">👥 Staff Management</a></li>
            <li class="nav-item"><a asp-controller="Admin" asp-action="AuditOrders">📜 Order Audit</a></li>
            <li class="nav-item"><a asp-controller="Inventory" asp-action="ManageProduct">📦 Manage Stock</a></li>
            <li class="nav-item"><a asp-controller="Inventory" asp-action="ManagePromotion">🏷️ Promotions</a></li>
        </ul>
    </div>
    <div class="main-content">
        <div class="top-bar">
            <span style="color: var(--admin-blue); font-weight: bold;">Sirin Engineering System</span>
            <a asp-controller="Product" asp-action="Index" class="btn-logout">Logout</a>
        </div>
        <div style="padding: 30px;">
            @RenderBody()
        </div>
    </div>
</body>
</html>