@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Staff Portal - Sirin Engineering</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <style>
            :root {
                --staff-blue: #003D7C;
                --staff-blue-soft: #0b4fa8;
                --staff-dark: #002244;
                --bg-light: #f1f5f9;
                --text-muted: rgba(255, 255, 255, 0.75);
            }

            body {
                margin: 0;
                font-family: 'Inter', 'Segoe UI', sans-serif;
                background: var(--bg-light);
                color: #1e293b;
            }
    
            /* ===== NAVBAR ===== */
            .navbar-staff {
                background: linear-gradient(90deg, var(--staff-blue), var(--staff-blue-soft));
                padding: 0 50px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                color: white;
                height: 68px;
                box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
            }
    
            .nav-brand {
                display: flex;
                align-items: center;
                gap: 18px;
            }

            .logo-small {
                height: 38px;
                border-radius: 8px;
                background: white;
                padding: 3px;
            }

            .brand-text {
                font-weight: 700;
                font-size: 1rem;
                letter-spacing: 1px;
                opacity: 0.9;
            }

            .welcome-text {
                font-size: 0.9rem;
                opacity: 0.85;
                display: flex;
                align-items: center;
                gap: 6px;
            }

            /* ===== MENU ===== */
            .nav-links {
                display: flex;
                align-items: center;
                gap: 8px;
                height: 100%;
            }

            .nav-links a.nav-item {
                color: var(--text-muted);
                text-decoration: none;
                font-weight: 500;
                font-size: 0.9rem;
                padding: 6px 14px;
                display: flex;
                align-items: center;
                gap: 6px;
                border-radius: 8px;
                transition: all 0.25s ease;
            }

            .nav-links a.nav-item:hover {
                color: white;
                background: rgba(255, 255, 255, 0.12);
            }
    
            /* Active = minimal highlight */
            .nav-links a.nav-item.active {
                color: #fff;
                background: rgba(255, 255, 255, 0.18);
                font-weight: 600;
            }

            /* ===== LOGOUT ===== */
            .btn-logout {
                background: rgba(220, 53, 69, 0.9);
                color: white !important;
                border-radius: 8px;
                padding: 6px 14px;
                margin-left: 10px;
                font-weight: 600;
                font-size: 0.85rem;
                text-decoration: none;
                display: flex;
                align-items: center;
                gap: 6px;
                transition: 0.2s;
            }

            .btn-logout:hover {
                background: #dc3545;
                transform: translateY(-1px);
            }

            /* ===== CONTENT ===== */
            .content-container {
                max-width: 1250px;
                margin: 35px auto;
                background: white;
                padding: 30px;
                border-radius: 14px;
                min-height: 80vh;
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
            }
    </style>
</head>

<body>
    <nav class="navbar-staff">
        <div class="nav-brand">
            <img src="~/images/Logo.jpg" class="logo-small" alt="Logo" />
            <span class="brand-text">SALES SYSTEM</span>
            <span class="welcome-text">
                <i class="bi bi-person-circle fs-5"></i>
                @(User.Identity?.Name ?? "Staff")
            </span>
        </div>
        <div class="nav-links">
            <a asp-controller="Sales" asp-action="OrderManage"
                   class="nav-item @(currentAction == "OrderManage" ? "active" : "")">
                <i class="bi bi-clipboard-check"></i> จัดการคำสั่งซื้อ
            </a>

            <a asp-controller="Sales" asp-action="Shop" class="nav-item @(currentAction == "Shop" ? "active" : "")">
                <i class="bi bi-cart-check"></i> POS / ขายสินค้า
            </a>
            <a asp-controller="Sales" asp-action="StockCheck"
                   class="nav-item @(currentAction == "StockCheck" ? "active" : "")">
                <i class="bi bi-box-seam"></i> เช็คสต็อกสินค้า
            </a>
    
            <a asp-controller="Account" asp-action="Logout" class="btn-logout">
                <i class="bi bi-box-arrow-right"></i> ออกจากระบบ
            </a>
        </div>
    </nav>
    
    <div class="content-container">
        @RenderBody()
    </div>
</body>

</html>